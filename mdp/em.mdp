
;title       = em

;; O que vou fazer? E aí fazer o quê?
integrator  = steep  ; minimização
emtol       = 50.0    ; parar em emtol kJ/mol
nsteps      = 10000  ; máximo de iterações

;; Frequência para salvar 
nstenergy   = 1000  ; energias
nstxtcout   = 1000  ; coordenadas no xtc
nstvout     = 1000  ; velocidades
nstfout     = 1000  ; forças

;; Como encontrar vizinhos e calcular interações
nstlist     = 10       ; freq para atualizar lista de vizinhos e forças de longo alcance
ns_type     = grid    ; método para determinar lista de vizinhos
rlist       = 1.0     ; cutoff para vizinhos em forças de curto alcance
cutoff-scheme = Verlet
coulombtype = PME     ; tratamento para forças de longo alcance
rcoulomb    = 1.0     ; cutoff para estas forças
vdwtype     = cut-off ; tratamento para VdW de longo alcance
rvdw        = 1.0     ; cut-off para VdW
