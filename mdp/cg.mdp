; VARIOUS PREPROCESSING OPTIONS
;title                    = cg
;; O que vou fazer? E a fazer o qu?
integrator  = cg           ; gradiente conjugado
define      = -DFLEXIBLE   ; agua flexivel
emtol       = 10.0         ; parar quando Fmax < emtol (kJ/mol/nm)
nsteps      = 50000        ; maximo de passos (protocolo TcTR: 50.000; gradiente conjugado, agua flexivel)
nstcgsteep  = 100
;; Frequncia para salvar 
nstenergy   = 1000  ; energias
nstxtcout   = 1000  ; coordenadas no xtc
nstvout     = 1000  ; velocidades
nstfout     = 1000  ; foras
;; Como encontrar vizinhos e calcular interaes
nstlist     = 10       ; freq para atualizar lista de vizinhos e foras de longo alcance
ns_type     = grid    ; mtodo para determinar lista de vizinhos
rlist       = 1.0     ; cutoff para vizinhos em foras de curto alcance
cutoff-scheme = Verlet
coulombtype = PME     ; tratamento para foras de longo alcance
rcoulomb    = 1.0    ; cutoff para estas foras
vdwtype     = cut-off ; tratamento para VdW de longo alcance
rvdw        = 1.0     ; cut-off para VdW
